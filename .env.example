# Team Vault MCP configuration. Copy to `.env` for local runs (gitignored).
TEAM_VAULT_URL=https://teamvault.artillect.pro
TEAM_VAULT_API_KEY=osync_your_api_key_here
# Optional: default project so tools can omit projectId.
# TEAM_VAULT_PROJECT_ID=cmq...
# Optional: read-only mode (no write/move/delete tools).
# TEAM_VAULT_READ_ONLY=1
